# =============================================================
# OPTMUS CORE - exemplo de configuracao
# Copie para .env e preencha. NUNCA versione o .env.
# =============================================================

# -------------------------------------------------------------
# NUCLEO (F0)
# -------------------------------------------------------------
# dev | prod
OPTMUS_ENV=dev

# Chave mestra do Core. Usada para assinar/derivar segredos e para
# criptografar tokens OAuth em repouso (secao 9 da spec).
# Minimo 32 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# OBRIGATORIA - o processo nao sobe sem ela.
OPTMUS_SECRET_KEY=

# Diretorio de dados locais (banco, indices, perfil).
OPTMUS_DATA_DIR=data

# Caminho do SQLite. Vazio = <OPTMUS_DATA_DIR>/optmus.db
OPTMUS_DB_PATH=

# debug | info | warning | error
OPTMUS_LOG_LEVEL=info
# true = log JSON (prod), false = console colorido (dev). Vazio = auto por OPTMUS_ENV.
OPTMUS_LOG_JSON=

# Servidor HTTP/WebSocket. 127.0.0.1 = so a propria maquina alcanca.
# Em container use 0.0.0.0 - e ai OPTMUS_API_TOKEN passa a ser OBRIGATORIO.
OPTMUS_HTTP_HOST=127.0.0.1
# Railway/Render/Fly injetam PORT (sem prefixo) e ele tem precedencia.
OPTMUS_HTTP_PORT=8420

# Bearer token da API do Core. Vazio = sem autenticacao, aceitavel SO em
# 127.0.0.1. Exposto (host publico ou OPTMUS_ENV=prod) sem token, o Core
# recusa subir - a API entrega memoria pessoal e execucao de ferramenta.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OPTMUS_API_TOKEN=

# Barramento de eventos: tamanho da fila por assinante.
# Fila cheia = evento mais antigo descartado + warning (degradacao graciosa).
OPTMUS_BUS_QUEUE_MAXSIZE=1000

# Retencao de eventos no SQLite, em dias (0 = nunca expurga).
OPTMUS_EVENT_RETENTION_DAYS=90

# -------------------------------------------------------------
# IDENTIDADE / VOZ
# -------------------------------------------------------------
OPTMUS_USER_NAME=Luiz
OPTMUS_USER_HONORIFIC=senhor
OPTMUS_WAKE_WORD=optmus

# -------------------------------------------------------------
# MEMORIA (F2)
# -------------------------------------------------------------
# auto     = tenta fastembed, cai no hashing se nao estiver instalado
# fastembed = exige o extra [memoria]; unico com semantica de verdade
# hashing  = sem dependencia, mas e busca LEXICAL: acha palavra, nao sentido
OPTMUS_EMBEDDING_PROVIDER=auto
OPTMUS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Dimensao dos vetores da tabela vec0. Precisa bater com o modelo:
#   hashing  -> qualquer valor (1024 e um bom padrao)
#   multilingual-e5-small -> 384
# Trocar depois de popular o banco exige POST /memoria/reindexar.
OPTMUS_EMBEDDING_DIM=1024

# Memoria de trabalho: contexto da conversa atual, volatil.
OPTMUS_WORKING_MEMORY_TTL_MIN=30
OPTMUS_WORKING_MEMORY_TURNS=12

# Decaimento de relevancia (meia-vida em dias).
OPTMUS_EPISODIC_HALF_LIFE_DAYS=14
OPTMUS_SEMANTIC_HALF_LIFE_DAYS=180

# Quantas memorias entram no prompt por turno, e o corte de score.
OPTMUS_RECALL_LIMIT=5
OPTMUS_RECALL_MIN_SCORE=0.12

# Ocorrencias em SEMANAS distintas para um padrao virar rotina.
OPTMUS_PROCEDURAL_MIN_OCCURRENCES=3

# Consolidador noturno - o "sono" do sistema.
OPTMUS_CONSOLIDATOR_ENABLED=true
OPTMUS_CONSOLIDATOR_HOUR=4

# Perfil vivo. Vazio = <OPTMUS_DATA_DIR>/perfil.md
OPTMUS_PROFILE_PATH=

# -------------------------------------------------------------
# CEREBRO (F1/F3)
# -------------------------------------------------------------
OPTMUS_ANTHROPIC_API_KEY=
# Para menor latencia de voz: claude-haiku-4-5 ou claude-sonnet-5.
OPTMUS_ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Voz usa low: latencia e feature (secao 3).
# NAO desligue o thinking para ganhar latencia - com ele desligado o modelo as
# vezes escreve a chamada de ferramenta como texto e a ferramenta nunca roda.
OPTMUS_LLM_EFFORT=low
OPTMUS_LLM_MAX_TOKENS=1024
# Rodadas de tool-calling por turno (porte do engine.ts do Optmus Web).
OPTMUS_LLM_MAX_ROUNDS=6
# Fallback local offline (Ollama)
OPTMUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
OPTMUS_OLLAMA_MODEL=qwen2.5:7b

# -------------------------------------------------------------
# STT / TTS (F1)
# -------------------------------------------------------------
# tiny | base | small | medium
OPTMUS_WHISPER_MODEL=small
OPTMUS_WHISPER_COMPUTE_TYPE=int8
OPTMUS_WHISPER_LANGUAGE=pt
OPTMUS_ELEVENLABS_API_KEY=
OPTMUS_ELEVENLABS_VOICE_ID=
# flash = menor latencia; use a API de streaming, nunca a de arquivo inteiro.
OPTMUS_ELEVENLABS_MODEL=eleven_flash_v2_5
# Fallback offline. Vazio = pula o Piper e cai no TTS do sistema.
OPTMUS_PIPER_MODEL_PATH=
OPTMUS_PIPER_BINARY=piper

# -------------------------------------------------------------
# VOZ (F1) - captura, wake word e fim de fala
# -------------------------------------------------------------
# true liga o microfone no boot. Sem isso, so o caminho de texto (/voz/texto).
OPTMUS_VOICE_ENABLED=false
OPTMUS_AUDIO_SAMPLE_RATE=16000
OPTMUS_AUDIO_FRAME_MS=20
# Vazio = dispositivo padrao do SO. Aceita indice ou trecho do nome.
OPTMUS_AUDIO_INPUT_DEVICE=
OPTMUS_AUDIO_OUTPUT_DEVICE=

# Modelo openWakeWord treinado para "Optmus". Vazio = so gatilho manual.
# Treine com ~500 amostras da SUA voz + ruido do SEU ambiente real.
OPTMUS_WAKE_MODEL_PATH=
OPTMUS_WAKE_THRESHOLD=0.5
OPTMUS_WAKE_COOLDOWN_S=1.5

# Fim de fala: silencio continuo que encerra a captura.
OPTMUS_VAD_SILENCE_MS=700
OPTMUS_VAD_ENERGY_THRESHOLD=400
OPTMUS_VAD_MAX_UTTERANCE_S=15
OPTMUS_VAD_MIN_UTTERANCE_MS=250

# Meta de wake-word -> primeira silaba (secao 3). Acima disso, alerta no log.
OPTMUS_LATENCY_TARGET_MS=1200
OPTMUS_METRICS_WINDOW=200

# -------------------------------------------------------------
# OPTMUS WEB (F3) - o outro projeto, consumido como servico
# -------------------------------------------------------------
# URL ESTAVEL do deploy (dominio de producao, nao a URL de preview
# da Vercel, que muda a cada deploy). Documentar no README dos dois repos.
OPTMUS_WEB_BASE_URL=
# Senha usada para derivar o token HMAC, igual ao frontend do Web faz.
OPTMUS_WEB_PASSWORD=
OPTMUS_WEB_TIMEOUT_S=5.0

# Contrato real: Authorization: Bearer <token>, onde
#   token = HMAC-SHA256(chave='jarvis-auth-v1', mensagem=senha) em hex.
# bearer = o contrato atual. header = escape se o Web passar a ler header proprio.
OPTMUS_WEB_AUTH_SCHEME=bearer
OPTMUS_WEB_AUTH_HEADER=X-Optmus-Auth

# -------------------------------------------------------------
# BUSCA WEB (F3)
# -------------------------------------------------------------
# Ferramenta server-side da Anthropic: sem chave de outro fornecedor, com
# citacao. So funciona com o cerebro na nuvem - offline nao ha busca web.
OPTMUS_WEB_SEARCH_ENABLED=true
OPTMUS_WEB_SEARCH_MAX_USES=5

# -------------------------------------------------------------
# NOTION - acesso direto a fonte, para conferir contra o Optmus Web
# -------------------------------------------------------------
# Integracao interna criada em notion.so/my-integrations.
# IMPORTANTE: criar o token nao basta - e preciso COMPARTILHAR cada base com
# a integracao (abra a base -> ... -> Conexoes -> adicione).
OPTMUS_NOTION_TOKEN=
OPTMUS_NOTION_VERSION=2022-06-28
OPTMUS_NOTION_TIMEOUT_S=15
# Mapa base->papel e nome de propriedade. Vazio = <OPTMUS_DATA_DIR>/notion_map.json
# Gere um rascunho com GET /notion/descobrir e revise antes de confiar.
OPTMUS_NOTION_MAP_PATH=
# Janela de meses do /api/stats/monthly. Ajuste se o Web usar outra.
OPTMUS_NOTION_MONTHS_WINDOW=6
# Janela dos alertas: +-30 dias, MEDIDA contra o Web por busca binaria.
# A borda da frente e inclusiva e a de tras exclusiva - e o que reproduz uma
# janela calculada em timestamp comparando so a data. Vazio no PAST_DAYS =
# sem limite para tras (lista prazo vencido de qualquer epoca).
OPTMUS_NOTION_ALERT_WINDOW_DAYS=30
OPTMUS_NOTION_ALERT_PAST_DAYS=30

# -------------------------------------------------------------
# INTEGRACOES EXTERNAS (F6) - opcional na F0
# -------------------------------------------------------------
# Telegram - canal dos avisos proativos. Caminho oficial: Bot API publica,
# gratuita, sem aprovacao e sem risco de banimento.
#   1. Fale com o @BotFather, mande /newbot, cole o token aqui.
#   2. Abra a conversa com o SEU bot e mande um "oi".
#   3. Rode `python scripts/telegram_id.py` e copie o CHAT_ID que ele mostrar.
# Sem os DOIS preenchidos a ferramenta some do schema do modelo.
OPTMUS_TELEGRAM_BOT_TOKEN=
# Destino unico, de proposito: o modelo escolhe o texto, nunca para quem.
OPTMUS_TELEGRAM_CHAT_ID=

# WhatsApp NAO OFICIAL (neonize/whatsmeow) - leia docs/WHATSAPP.md antes.
#   - Use um numero SECUNDARIO. A conta sera banida; a duvida e quando.
#   - So funciona local: em Railway/Render a ferramenta se recusa a existir,
#     e isso nao depende desta variavel.
#   - pip install -e ".[whatsapp]" e depois python scripts/whatsapp_parear.py
OPTMUS_WHATSAPP_ENABLED=false
OPTMUS_WHATSAPP_SESSION_PATH=data/whatsapp.db
# Apelido -> numero, escrito a mao. O modelo escolhe um APELIDO desta lista e
# nunca digita um numero - e o que impede uma instrucao injetada de escolher
# o destinatario. Formato em docs/WHATSAPP.md.
OPTMUS_WHATSAPP_CONTACTS_PATH=data/contatos.json

# Caminho OFICIAL (Business API) - nao usado, ver docs/WHATSAPP.md.
OPTMUS_WHATSAPP_TOKEN=
OPTMUS_WHATSAPP_PHONE_NUMBER_ID=
# Instagram - SO LEITURA (perfil, metricas, comentarios). A API oficial nao
# tem lista de seguidores nem follow/unfollow: ver docs/INSTAGRAM.md.
# O token longo vale 60 DIAS. O Core renova sozinho quando faltam <=10 dias,
# mas so se estiver ligado: token vencido NAO se renova, so refazendo o OAuth.
OPTMUS_INSTAGRAM_TOKEN=
# O `user_id` de GET /me?fields=user_id,username - nao o @ do perfil.
OPTMUS_INSTAGRAM_ACCOUNT_ID=
OPTMUS_GOOGLE_CLIENT_ID=
OPTMUS_GOOGLE_CLIENT_SECRET=
OPTMUS_HOMEASSISTANT_BASE_URL=
OPTMUS_HOMEASSISTANT_TOKEN=

# -------------------------------------------------------------
# SEGURANCA (secao 9)
# -------------------------------------------------------------
# Teto de acoes EXTERNO/DESTRUTIVO por hora.
OPTMUS_EXTERNAL_ACTION_RATE_LIMIT=20
# Frase-codigo exigida antes de acao DESTRUTIVA.
OPTMUS_DESTRUCTIVE_PASSPHRASE=
# Janela cancelavel antes de executar acao destrutiva (segundos).
OPTMUS_DESTRUCTIVE_DELAY_S=5
# Execucoes em dry-run que toda ferramenta nova cumpre antes de agir de verdade.
# -------------------------------------------------------------
# MODO DESENVOLVEDOR (F10) - so local, exige Docker
# -------------------------------------------------------------
# O Optmus programa nos projetos registrados e PUBLICA sozinho: o portao de
# confirmacao no deploy foi dispensado por decisao explicita (26/08/2026).
# O que NAO foi dispensado: sandbox (Docker rodando, sem rede, montagem
# somente-leitura), auditoria de toda acao, e o limite de superficie.
# Leia docs/MODO_DESENVOLVEDOR.md antes de ligar.
OPTMUS_DEV_ENABLED=false
# Raizes dos projetos. O modelo manda id + caminho RELATIVO, nunca absoluto.
OPTMUS_DEV_PROJECTS_PATH=data/projetos.json
# Teto de arquivos apagados num commit. Acima disso, recusa - freio estrutural
# contra "apaga tudo" que nao depende do codigo gerado ser bom.
OPTMUS_DEV_MAX_DELECOES=8

# -------------------------------------------------------------
# ABRIR COISAS NO PC (F8) - so local
# -------------------------------------------------------------
# Desligado por padrao. Em plataforma hospedada a ferramenta se recusa a
# existir, e isso NAO depende desta variavel. Leia docs/HUD_GESTUAL.md.
OPTMUS_PC_ENABLED=false
# Apps e pastas registrados a mao. O modelo escolhe um ID desta lista e nunca
# digita um caminho - e o que impede uma instrucao injetada de escolher o que
# abrir. Executavel dentro de pasta registrada continua barrado; para rodar um
# app, registre ele explicitamente na secao "apps".
OPTMUS_PC_TARGETS_PATH=data/alvos.json

# -------------------------------------------------------------
# PROATIVIDADE (F7) - a unica funcao que fala sem ser chamada
# -------------------------------------------------------------
# Desligada por padrao: ligar sozinha seria decidir por quem instalou.
# Leia docs/PROATIVIDADE.md antes.
OPTMUS_PROACTIVE_ENABLED=false
# Teto rigido por dia civil. Ao zerar, os avisos param - nao entram em fila.
OPTMUS_PROACTIVE_DAILY_BUDGET=5
OPTMUS_PROACTIVE_INTERVAL_MIN=30
# Janela de silencio [inicio, fim). Aviso que venceria aqui e DESCARTADO, nao
# adiado: a fonte e relida a cada ciclo, entao o que ainda importar de manha
# aparece sozinho. Adiar produziria enxurrada as 8h.
OPTMUS_PROACTIVE_QUIET_START=22
OPTMUS_PROACTIVE_QUIET_END=8
# Mesmo assunto nao se repete dentro disso.
OPTMUS_PROACTIVE_COOLDOWN_H=12

OPTMUS_TOOL_SANDBOX_RUNS=3
# Teto de falas espontaneas por dia (F7).
OPTMUS_PROACTIVE_DAILY_BUDGET=5
